{
  "name": "sdk-e-auth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n next,mail,mailui -c blue,green,yellow \"pnpm --filter @sdk-e/platform dev\" \"node scripts/mail/mail-sink.ts\" \"node scripts/mail/mail-open.ts\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sdk-e/db generate",
    "db:migrate": "pnpm --filter @sdk-e/db migrate",
    "db:seed": "node scripts/db/seed.ts",
    "keys:rotate": "node scripts/db/rotate-keys.ts",
    "db:studio": "pnpm --filter @sdk-e/db studio",
    "mail": "node scripts/mail/mail-sink.ts",
    "mail:ui": "node scripts/mail/mail-open.ts",
    "mail:list": "node scripts/mail/mail-cli.ts list",
    "mail:read": "node scripts/mail/mail-cli.ts read",
    "mail:wait": "node scripts/mail/mail-cli.ts wait",
    "mail:clear": "node scripts/mail/mail-cli.ts clear",
    "mail:health": "node scripts/mail/mail-cli.ts health",
    "mail:mcp": "node scripts/mail/mail-mcp.ts",
    "redis": "node scripts/redis/local-server.ts",
    "ports:list": "node scripts/portkiller/portkiller.ts list",
    "ports:find": "node scripts/portkiller/portkiller.ts find",
    "ports:check": "node scripts/portkiller/portkiller.ts check",
    "ports:pid": "node scripts/portkiller/portkiller.ts pid",
    "ports:kill": "node scripts/portkiller/portkiller.ts kill",
    "ports:kill-force": "node scripts/portkiller/portkiller.ts kill-force"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sdk-e/db": "workspace:*",
    "@sdk-e/engine": "workspace:*",
    "@sdk-e/shared": "workspace:*",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.5",
    "smtp-tester": "^2.1.0",
    "turbo": "^2.10.11",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  }
}
